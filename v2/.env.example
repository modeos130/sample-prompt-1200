# BooManLab / Sample Prompt 1200
# Copy to .env.local and fill in values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_OWNER_EMAIL=owner@example.com

# AI APIs
GEMINI_KEY=your-gemini-key

# Optional overrides
GEMINI_PROMPT_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
LYRIA_CLIP_MODEL=lyria-3-clip-preview
LYRIA_PRO_MODEL=lyria-3-pro-preview
RATE_LIMIT_CALLS=10
RATE_LIMIT_WINDOW=86400000
ANALYZE_RATE_LIMIT=10
MUSIC_RATE_WINDOW=86400000
MONTHLY_HARD_CAP=500
UPLOAD_AUDIO_MAX_MB=25
